# Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env && chmod 600 .env
#
# Create the token at: https://canvas.mit.edu/profile/settings
#   -> Approved Integrations -> + New Access Token
# Set an expiration shortly after the homework due date.

CANVAS_BASE_URL=https://canvas.mit.edu
CANVAS_API_TOKEN=paste_your_token_here
CANVAS_COURSE_ID=40577
CANVAS_TOPIC_ID=448963

# --- optional tuning -------------------------------------------------------
# AGENT_STATE_DIR=./var
# AGENT_MAX_POSTS_PER_HOUR=3          # hard-capped at 3 by the assignment
# AGENT_MAX_CONSECUTIVE_FAILURES=5    # breaker trips at this many
# AGENT_BREAKER_COOLDOWN_MINUTES=180
# AGENT_NEW_THREAD_MIN_GAP_HOURS=24
# AGENT_HTTP_TIMEOUT=30
# AGENT_HTTP_MAX_ATTEMPTS=4
# AGENT_DRY_RUN=0                     # 1 = decide but never write to Canvas
